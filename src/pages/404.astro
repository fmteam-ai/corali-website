---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Sun from "../components/Sun.astro";
import { t, homePath } from "../i18n";
const el = t("el"), en = t("en");
---
<Base lang="en" title={`${en.notFound.title} · Hotel Corali`} noindex>
  <Header lang="en" />
  <main id="main" class="notfound container">
    <Sun class="nf-sun" />
    <h1 class="h2">{en.notFound.title}</h1>
    <p>{en.notFound.text}</p>
    <p lang="el">{el.notFound.title}. {el.notFound.text}</p>
    <p class="nf-links"><a class="btn btn-coral" href={homePath("en")}>{en.notFound.home}</a> <a class="btn btn-ghost" href={homePath("el")} hreflang="el" lang="el">{el.notFound.home}</a></p>
  </main>
</Base>
