---
import V3Page from "../../../v3/V3Page.astro";
import { locales, defaultLocale } from "../../../i18n";

export function getStaticPaths() {
  return locales.filter((l) => l.code !== defaultLocale).map((l) => ({ params: { lang: l.code } }));
}
const { lang } = Astro.params;
---
<V3Page lang={lang!} />
