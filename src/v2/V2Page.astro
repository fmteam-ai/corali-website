---
// Corali v2 — "Island Index": dark editorial / brutalist design. Split screen on desktop (fixed console on the left),
// full-screen story panels on phones. Same data, photos and languages as v1, plus live prices from the booking engine.
import "@fontsource-variable/roboto-flex/standard.css";
import "@fontsource-variable/jetbrains-mono/wght.css";
import "./v2.css";
import { Picture, Image, getImage } from "astro:assets";
import { t, locales, localeOf, homePath, v2Path, asset, type Lang } from "../i18n";
import { hotel, bookUrl, mapsUrl } from "../data/hotel";
import { rooms } from "../data/rooms";
import { reviews } from "../data/reviews";
import { beaches } from "../data/beaches";
import logo from "../assets/hotel-corali-logo.png";
import heroImg from "../assets/gallery/aerial.jpg";
import imgBalcony from "../assets/gallery/balcony-bay.jpg";
import imgLogaras from "../assets/gallery/logaras.jpg";
import imgHarbour from "../assets/gallery/village-harbour.jpg";
import imgPines from "../assets/gallery/bay-pines.jpg";
import imgNight from "../assets/gallery/night-balcony.jpg";
import imgVillage from "../assets/village-night.jpg";

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const v = d.v2;
const loc = localeOf(lang);
const intl = lang === "en" ? "en-GB" : loc.hreflang;
const eur = (n: number) => new Intl.NumberFormat(intl, { style: "currency", currency: "EUR", maximumFractionDigits: 0 }).format(n);
const dayImgs = [imgBalcony, imgLogaras, imgHarbour, imgPines, imgNight];
const canonical = new URL(homePath(lang), Astro.site).href;
const year = new Date().getFullYear();
const ogImg = await getImage({ src: heroImg, width: 1200, format: "jpg" });
const heroBg = await getImage({ src: heroImg, width: 1600, format: "webp" });
const roomImgs = Object.fromEntries(await Promise.all(rooms.map(async (r) => [r.id, (await getImage({ src: r.img, width: 900, format: "webp" })).src])));
const ids = ["arrive", "rooms", "day", "ask", "find"];

const client = {
  lang, intl, geo: hotel.geo, book: hotel.bookingBase, winds: d.winds,
  beaches: beaches.map((b) => ({ name: lang === "el" ? b.el : b.latin, km: b.km, sheltered: b.sheltered })),
  cal: { checkIn: d.booking.checkIn, checkOut: d.booking.checkOut, prev: d.booking.prev, next: d.booking.next, close: d.booking.close, nights: d.booking.nights, night: d.booking.night },
  r: v.results, roomImgs,
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{v.title}</title>
    <meta name="description" content={d.meta.description} />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0a0c0d" />
    <link rel="icon" href={asset("favicon.svg")} type="image/svg+xml" />
    <link rel="preload" as="image" href={heroBg.src} type="image/webp" fetchpriority="high" />
    <meta property="og:title" content={v.title} />
    <meta property="og:image" content={new URL(ogImg.src, Astro.site).href} />
    <script is:inline>if (!matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("motion");</script>
  </head>
  <body style={`--hero:url(${heroBg.src})`}>
    <a class="skip" href="#main">{d.a11y.skip}</a>

    <!-- Story progress (phones) -->
    <div class="story-bar" aria-hidden="true">{ids.map(() => <i><b></b></i>)}</div>

    <!-- LEFT CONSOLE (fixed on desktop, top bar on phones) -->
    <aside class="console" aria-label="Hotel Corali">
      <div class="c-top">
        <a class="c-logo" href={v2Path(lang)} aria-label={d.a11y.home}><Image src={logo} alt="Hotel Corali" width={150} height={38} densities={[1, 2]} loading="eager" /></a>
        <details class="c-lang">
          <summary>{loc.short}</summary>
          <ul>{locales.map((l) => <li><a href={v2Path(l.code)} hreflang={l.code} lang={l.code} aria-current={l.code === lang ? "true" : undefined}>{l.short} — {l.label}</a></li>)}</ul>
        </details>
      </div>

      <nav class="c-index" aria-label={v.index}>
        <p class="mono c-label">{v.index}</p>
        <ol>{v.chapters.map((c, i) => <li><a href={`#${ids[i]}`} data-link data-chapter={ids[i]}><span class="mono">0{i + 1}</span>{c}</a></li>)}</ol>
      </nav>

      <div class="c-live">
        <p class="mono c-label"><i class="blink"></i>{v.console}</p>
        <dl class="mono">
          <div><dt>{v.live.time}</dt><dd data-clock>--:--</dd></div>
          <div><dt>{v.live.sunset}</dt><dd data-sunset>--:--</dd></div>
          <div><dt>{v.live.sea}</dt><dd data-sea>--</dd></div>
          <div><dt>{v.live.wind}</dt><dd data-wind>--</dd></div>
          <div><dt>{v.live.calm}</dt><dd data-calm>--</dd></div>
          <div><dt>{v.coords}</dt><dd>37.0348°N 25.2575°E</dd></div>
        </dl>
        <a class="mono c-cam" href={hotel.webcam} target="_blank" rel="noopener">● {v.live.webcam} ↗</a>
      </div>

      <button class="c-book" type="button" data-open-sheet>{v.bookStay}<span aria-hidden="true">↗</span></button>
      <a class="mono c-classic" href={homePath(lang)}>{v.nav.classic} ↗</a>
    </aside>

    <main id="main" class="stage">
      <!-- 01 ARRIVE: the photo lives inside the letters, then you fly through the O -->
      <section id="arrive" class="panel arrive" data-chapter-panel="arrive" aria-labelledby="arrive-title">
        <div class="arrive-pin" data-arrive>
          <div class="arrive-photo" aria-hidden="true"></div>
          <h1 id="arrive-title" class="wordmark" data-wordmark><span class="sr-only">Hotel Corali, Piso Livadi, Paros — </span><span aria-hidden="true">CORALI</span></h1>
          <div class="arrive-meta">
            <p class="mono">{v.kicker}</p>
            <p class="arrive-lead">{v.lead}</p>
          </div>
          <p class="mono scroll-hint" aria-hidden="true">↓ {v.story} · {v.swipe}</p>
        </div>
      </section>

      <!-- STATEMENT -->
      <section class="panel statement" aria-label={v.chapters[0]}>
        <p class="statement-text" data-fill>{v.statement}</p>
        <div class="statement-figs">
          <p><b>200<small>m</small></b><span class="mono">{v.beach}</span></p>
          <p><b>{hotel.distances.portKm}<small>km</small></b><span class="mono">{v.port}</span></p>
          <p><b>{hotel.distances.airportKm}<small>km</small></b><span class="mono">{v.airport}</span></p>
          <p><b>{hotel.reviewsCount}</b><span class="mono">★★★★★</span></p>
        </div>
      </section>

      <!-- 02 ROOMS: index list (desktop, image follows the cursor) / story panels (phones) -->
      <section id="rooms" class="panel rooms" data-chapter-panel="rooms" aria-labelledby="rooms-title">
        <header class="ch-head"><span class="mono">02</span><h2 id="rooms-title">{v.rooms.title}</h2></header>
        <div class="r-index" role="list">
          <div class="r-row r-headrow mono" aria-hidden="true"><span>{v.no}</span><span>{v.room}</span><span>{v.bed}</span><span>{v.floor}</span><span>{v.price}</span></div>
          {rooms.map((r, i) => {
            const it = d.rooms.items[r.id];
            return (
              <button type="button" class="r-row" role="listitem" data-room={r.id} data-img={roomImgs[r.id]}>
                <span class="mono">0{i + 1}</span>
                <span class="r-name">{it.name}</span>
                <span class="r-bed">{it.bed}</span>
                <span class="mono">{r.floor === 2 ? "02" : "01"}</span>
                <span class="r-price">{eur(r.from)}<small>{v.rooms.night}</small></span>
              </button>
            );
          })}
          <p class="mono fine">* {d.rooms.note}</p>
        </div>
        <div class="r-follow" aria-hidden="true" data-follow><img alt="" src={roomImgs.deluxeDouble} width="300" height="380" loading="lazy" data-follow-img /></div>

        <!-- Phone stories -->
        <div class="r-stories">
          {rooms.map((r, i) => {
            const it = d.rooms.items[r.id];
            return (
              <article class="story">
                <Picture src={r.img} formats={["avif", "webp"]} fallbackFormat="jpg" widths={[480, 800]} sizes="100vw" alt={it.alt} loading="lazy" class="story-img" />
                <div class="story-copy">
                  <p class="mono">0{i + 1} / 0{rooms.length} · {it.bed}</p>
                  <h3>{it.name}</h3>
                  <p class="story-price">{v.price} {eur(r.from)} <small>{v.rooms.night}</small></p>
                  <button type="button" class="btn-line" data-room={r.id}>{v.view} →</button>
                </div>
              </article>
            );
          })}
        </div>
      </section>

      <!-- 03 A DAY: horizontal film strip -->
      <section id="day" class="panel day" data-chapter-panel="day" aria-labelledby="day-title">
        <div class="day-pin" data-day-pin>
          <header class="ch-head"><span class="mono">03</span><h2 id="day-title">{v.day.title}</h2></header>
          <ol class="strip" data-strip>
            {v.day.steps.map((s, i) => (
              <li class="frame">
                <Picture src={dayImgs[i]} formats={["avif", "webp"]} fallbackFormat="jpg" widths={[480, 900, 1300]} sizes="(min-width: 960px) 46vw, 86vw" alt="" loading="lazy" />
                <div class="frame-cap"><span class="mono">{s.time}</span><h3>{s.t}</h3><p>{s.x}</p></div>
              </li>
            ))}
          </ol>
          <div class="strip-progress" aria-hidden="true"><i data-strip-progress></i></div>
        </div>
      </section>

      <!-- 04 ASK: terminal-style concierge -->
      <section id="ask" class="panel ask" data-chapter-panel="ask" aria-labelledby="ask-title">
        <header class="ch-head"><span class="mono">04</span><h2 id="ask-title">{v.ask.title}</h2></header>
        <div class="term" aria-hidden="true">
          <p class="term-top mono"><i></i><i></i><i></i> corali — concierge</p>
          <div class="term-body mono">
            <p data-type>&gt; {v.ask.q1}</p>
            <p class="term-a" data-type>{v.ask.a1}</p>
            <p data-type>&gt; {v.ask.q2}</p>
            <p class="term-a" data-type>{v.ask.a2}</p>
            <p class="term-cursor">&gt; <span class="caret"></span></p>
          </div>
        </div>
        <p class="ask-text">{v.ask.text}</p>
        <button class="btn-solid" type="button" data-ask>{v.ask.button} →</button>

        <div class="quote" data-quotes>
          {reviews.map((r, i) => (
            <figure class:list={["q", { "is-on": i === 0 }]} data-q>
              <blockquote lang={r.lang}>“{r.text}”</blockquote>
              <figcaption class="mono">{String(i + 1).padStart(2, "0")}/{String(reviews.length).padStart(2, "0")} — {r.name} · {r.lang.toUpperCase()}</figcaption>
            </figure>
          ))}
        </div>
      </section>

      <!-- 05 FIND US -->
      <section id="find" class="panel find" data-chapter-panel="find" aria-labelledby="find-title">
        <div class="find-bg" aria-hidden="true"><Picture src={imgVillage} formats={["avif", "webp"]} fallbackFormat="jpg" widths={[640, 1200, 1800]} sizes="(min-width: 960px) 66vw, 100vw" alt="" loading="lazy" /></div>
        <header class="ch-head"><span class="mono">05</span><h2 id="find-title">{v.where.title}</h2></header>
        <p class="find-coords mono">37.0348°N<br />25.2575°E</p>
        <ul class="find-list">{d.village.items.map((x) => <li><b>{x.title}</b><span>{x.text}</span></li>)}</ul>
        <div class="find-links">
          <a class="btn-line" href={mapsUrl} target="_blank" rel="noopener">{v.where.map} ↗</a>
          <a class="btn-line" href={`tel:${hotel.phone}`}>{hotel.phoneDisplay}</a>
          <a class="btn-line" href={`mailto:${hotel.email}`}>{hotel.email}</a>
        </div>
        <footer class="find-foot mono">
          <span>© {year} Hotel Corali · {lang === "el" ? hotel.addressEl : "Piso Livadi, Paros 844 00"}</span>
          <span>{hotel.social.map((s) => <a href={s.url} target="_blank" rel="noopener me">{s.name}</a>)}</span>
          {loc.auto && <span>{d.footer.auto}</span>}
        </footer>
      </section>
    </main>

    <!-- Phone bottom dock -->
    <div class="dock">
      <button class="dock-book" type="button" data-open-sheet>{v.bookStay} ↗</button>
      <button class="dock-ask mono" type="button" data-ask aria-label={v.nav.ask}>?</button>
    </div>

    <!-- ROOM DRAWER -->
    <dialog class="drawer" data-drawer aria-labelledby="drawer-title">
      <button class="x mono" type="button" data-close>{v.close} ✕</button>
      {rooms.map((r, i) => {
        const it = d.rooms.items[r.id];
        return (
          <article class="dr" data-dr={r.id} hidden>
            <Picture src={r.img} formats={["avif", "webp"]} fallbackFormat="jpg" widths={[640, 1100, 1600]} sizes="(min-width: 960px) 60vw, 100vw" alt={it.alt} loading="lazy" class="dr-img" />
            <div class="dr-copy">
              <p class="mono">0{i + 1} · {r.floor === 2 ? d.rooms.floor2 : d.rooms.floor1} · {it.bed}</p>
              <h2 id={i === 0 ? "drawer-title" : undefined}>{it.name}</h2>
              <p>{it.text}</p>
              <p class="mono c-label">{v.amenities}</p>
              <ul class="dr-am">{r.amenities.map((a) => <li>{d.amenities[a]}</li>)}</ul>
              <p class="dr-price">{v.price} {eur(r.from)} <small>{v.rooms.night}*</small></p>
              <button class="btn-solid" type="button" data-open-sheet>{v.checkRoom} →</button>
            </div>
          </article>
        );
      })}
    </dialog>

    <!-- BOOKING SHEET: step 1 dates & guests → step 2 live rooms & prices -->
    <dialog class="sheet" data-sheet aria-labelledby="sheet-title" data-step2={v.step2}>
      <div class="sheet-in">
        <header class="sheet-head">
          <p class="mono" id="sheet-title"><span data-step-no>01</span>/02 — <span data-step-name>{v.step1}</span></p>
          <button class="x mono" type="button" data-close>{v.close} ✕</button>
        </header>
        <form class="sheet-form" action={hotel.bookingBase} method="get" data-bar>
          <h2 class="sheet-h">{v.bar.title}</h2>
          <label class="f">{d.booking.checkIn}<input type="date" name="checkIn" required data-in /></label>
          <label class="f">{d.booking.checkOut}<input type="date" name="checkOut" required data-out /></label>
          <label class="f">{d.booking.adults}<select name="adults" data-adults>{[1, 2, 3, 4, 5, 6].map((n) => <option selected={n === 2}>{n}</option>)}</select></label>
          <label class="f">{d.booking.children}<select name="children" data-children>{[0, 1, 2, 3, 4].map((n) => <option>{n}</option>)}</select></label>
          <input type="hidden" name="lang" value={lang} />
          <input type="hidden" name="utm_source" value="website" />
          <input type="hidden" name="utm_medium" value="referral" />
          <input type="hidden" name="utm_content" value="v2-sheet" />
          <button class="btn-solid sheet-go" type="submit">{v.show} →</button>
        </form>
        <section class="sheet-results" hidden data-results aria-live="polite">
          <button class="btn-line" type="button" data-back>← {v.back}</button>
          <h2 class="sheet-h" data-results-title></h2>
          <div data-results-list></div>
          <a class="btn-line" data-results-open href={bookUrl(lang, "v2-results")} rel="noopener">{v.results.open} ↗</a>
        </section>
      </div>
    </dialog>

    <div class="cursor" aria-hidden="true" data-cursor><span data-cursor-label>{v.view}</span></div>

    <script type="application/json" id="v2-data" set:html={JSON.stringify(client)} />
    <script>
      import "./v2.ts";
    </script>
  </body>
</html>
